# Copy to .env. Placeholders only; never commit real values.
ADDR=:8080
APP_SECRET=change-me-to-a-long-random-string
DEV_OTP=123456
DEMO_PHONE=+2348012345678
DEMO_PHONE_2=+2348098765432
# How often to look for new incoming credits (0 turns it off)
SCAN_INTERVAL_SECONDS=10
DATABASE_URL=postgres://apapo:apapo@localhost:5432/apapo?sslmode=disable
PROVIDER=mock
# Only for PROVIDER=real:
BANK_API_URL=
BANK_API_KEY=
# 32 random bytes, base64. Generate with: openssl rand -base64 32
ENCRYPTION_KEY=
# The frontend's origin, for example https://app.example.com. Empty: no browser on another origin may call the API.
ALLOWED_ORIGIN=
# true only when the API sits behind a proxy you run that sets X-Forwarded-For.
TRUST_PROXY=false
