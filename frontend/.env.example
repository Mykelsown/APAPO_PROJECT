# "mock" runs against the in-browser mock layer, "real" calls the Go backend.
VITE_API_MODE=mock
# Leave empty in dev: the Vite dev server proxies /api to APAPO_BACKEND_URL (default http://localhost:8080)
# because the backend sends no CORS headers. Set it only for a deployed backend that allows your origin.
VITE_API_BASE_URL=
# Serverless explanation function (F6). Public URL only, the model key lives server side.
VITE_EXPLAIN_URL=
